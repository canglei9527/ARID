# ============================================================
# ARID 飞书远程控制 worker - 环境变量模板
#
# 此文件通常由「配置 GUI」自动生成（见 install.bat/configure.bat），
# 位置在 feishu-worker\.env（本文件复制为 .env 后填写，或让 GUI 生成）。
# .env 不要提交进 git。
#
# 请到飞书开放平台创建「企业自建应用」，开通机器人能力与长连接（长连接模式）
# 事件订阅权限，拿到 App ID / App Secret 后填写下面凭证。
# ============================================================

# --- 飞书应用凭证（必填，用于长连接）---
FEISHU_APP_ID=cli_xxxxxxxx
FEISHU_APP_SECRET=xxxxxxxx
# 可选：开启「加密推送」时填 encrypt key
# FEISHU_ENCRYPT_KEY=

# --- 远程执行白名单（必填，否则远程执行默认禁用）---
# 多个目录用分号分隔；只有这些目录内的任务才会被执行
ARID_FEISHU_ALLOWED_DIRS=E:\myrepo;E:\GLM5.2\hubway-smart-router

# --- 可选：群聊严格 @ 匹配（机器人 open_id）---
# ARID_FEISHU_BOT_OPEN_ID=ou_xxxxxxxx

# --- 可选：超时/回复参数 ---
# ARID_FEISHU_TIMEOUT=1800
# ARID_FEISHU_REPLY_MAX_CHARS=3500
# ARID_FEISHU_OUTPUT_MAX_LINES=0

# --- 高等级（规划/审查）模型 ---
ARID_PLANNER_PROVIDER=openai_compatible
ARID_PLANNER_MODEL=gpt-5.6-sol
ARID_PLANNER_BASE_URL=https://your-gateway/v1
ARID_PLANNER_API_KEY=xxxx

# --- 低等级（执行）模型（可选，留空则单模型/用 profile 默认）---
# ARID_EXECUTOR_PROVIDER=deepseek
# ARID_EXECUTOR_MODEL=deepseek-chat
# ARID_EXECUTOR_BASE_URL=
# ARID_EXECUTOR_API_KEY=xxxx

# --- Tavily 搜索（可选）---
# TAVILY_API_KEY=xxxx
